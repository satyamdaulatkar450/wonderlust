<% layout("/layouts/boilerplate") %>
<style>
  #filters{
    display : flex;
    flex-direction : row;
    align-items : center;
  }
  .filter{
   text-align : center;
   margin-right : 2rem;
   margin-top : 2rem;
   opacity : 0.7;
  }
  .filter:hover{
   opacity : 1;
   cursor : pointer;
  }
  .filter p{
    font-size : 0.8rem;
  }
  .tax-info{
    display : none;
  }
  .tax-toggle{
    border : 1px solid black;
    border-radius : 1rem;
    height : 3.25rem;
    padding : 1rem;
    margin-left : 5rem;
    display : flex;
    align-items : center;
  }
  .filter.active {
  opacity: 1;
  border-bottom: 2px solid black;
}
@media (max-width: 768px)and (max-width: 992px) {
  #filters {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex-wrap: nowrap;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex-shrink: 0;
    margin-right: 0.8rem;
    margin-top: 1rem;
    min-width: 50px;
  }

  .filter p {
    font-size: 0.65rem;
  }

  .tax-toggle {
    margin-left: 1rem;
    height: auto;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
/* One card per row on mobile */
  .row {
    display: flex;
    flex-direction: column;
  }

  .col {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
  }

  .listing-card img {
    height: 15rem !important;
  }
}
@media (max-width: 992px) {
  .navbar {
    flex-wrap: wrap;
    padding: 0.5rem 1rem;
  }

  .navbar-brand {
    font-size: 1rem;
  }

  .navbar-nav {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nav-link {
    font-size: 0.85rem;
    padding: 0.3rem 0.5rem;
  }

  /* Search bar in navbar */
  .navbar .form-control,
  .navbar input[type="text"],
  .navbar input[type="search"] {
    width: 100%;
    margin-top: 0.5rem;
    border-radius: 2rem;
    font-size: 0.85rem;
    padding: 0.4rem 1rem;
  }

  .navbar .btn {
    font-size: 0.85rem;
    padding: 0.4rem 0.8rem;
  }

  /* Entire navbar search row full width */
  .navbar-search {
    width: 100%;
    order: 3;
    margin-top: 0.5rem;
  }
}

@media (max-width: 768px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .navbar-brand {
    font-size: 0.95rem;
  }

  .navbar-nav {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.4rem;
  }

  .nav-link {
    font-size: 0.8rem;
    padding: 0.25rem 0.4rem;
  }

  .navbar .form-control,
  .navbar input[type="text"],
  .navbar input[type="search"] {
    width: 100%;
    font-size: 0.8rem;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    margin-top: 0.4rem;
  }

  .navbar-search {
    width: 100%;
    order: 3;
    margin-top: 0.4rem;
  }

  /* Hamburger toggler */
  .navbar-toggler {
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
  }

  /* Collapsed menu full width */
  .navbar-collapse {
    width: 100%;
  }

  /* Filters */
  #filters {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex-wrap: nowrap;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex-shrink: 0;
    margin-right: 0.8rem;
    margin-top: 1rem;
    min-width: 50px;
  }

  .filter p {
    font-size: 0.65rem;
  }

  .tax-toggle {
    margin-left: 1rem;
    height: auto;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* One card per row */
  .row {
    display: flex;
    flex-direction: column;
  }

  .col {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
  }

  .listing-card img {
    height: 15rem !important;
  }
}
</style>
<body>
   <!-- <h3>All Listing</h3> -->
   <!-- <form method = "GET" action = "/listing/new">
    <button>Create New Listing</button>
   </form> -->
   <div id ="filters">
    <div class="filter" data-category="trending">
      <div><i class="fa-solid fa-fire"></i></div>
       <p>trending</p>
    </div>
    <div class="filter" data-category="Rooms">
      <div><i class="fa-solid fa-bed"></i></div>
      <p> rooms</p>
    </div>
    <div class="filter" data-category="Iconic Cities">
      <div><i class="fa-solid fa-mountain-city"></i></div>
       <p>iconic cities</p>
    </div>
    <div class="filter" data-category="castles">
      <div><i class="fa-brands fa-fort-awesome"></i></div>
      <p>castles</p>
    </div>
    <div class="filter"data-category="Amazing pools">
      <div><i class="fa-solid fa-person-swimming"></i></div>
       <p>amazing pools</p>
    </div>
    <div class="filter" data-category="camping">
      <div><i class="fa-solid fa-campground"></i></div>
       <p>camping</p>
    </div>
     <div class="filter" data-category="Farms">
      <div><i class="fa-solid fa-truck-field"></i></div>
      <p> farms</p>
    </div>
     <div class="filter" data-category="arctic">
      <div><i class="fa-solid fa-snowflake"></i></div>
       <P>arctic</P>
    </div>
    <div class="filter" data-category="domes">
      <div><i class="fa-solid fa-igloo"></i></div>
       <P>domes</P>
    </div>
    <div class="filter" data-category="Boat">
      <div><i class="fa-solid fa-sailboat"></i></div>
       <P>boat</P>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
     <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
     </div>
    </div>
   </div>
   <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
    <% for(let listing of alllisting){ %>
      <div class="col mb-4 listing-item" data-category="<%= listing.category %>">
      <a href = "/listing/<%= listing._id %>" class = "listing-link">
     <div class="card col listing-card">
      <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style = "height : 20rem;">
      <div class="card-img-overlay">abcd</div>
      <div class="card-body">
    <p class="card-text">
        <b><%= listing.title %></b>
        <br />
        &#8377;<%= listing.price.toLocaleString("en-IN") %> /night
        <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
    </p>
  </div>
  </div>
  </a>
</div>
<% } %>
</div>
<script>
  let taxswitch = document.getElementById("switchCheckDefault");
  taxswitch.addEventListener("click",()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
       info.style.display = "inline"; 
      }
      else{
        info.style.display = "none";
      }    
    }
  })

const filters = document.querySelectorAll(".filter");
const listings = document.querySelectorAll(".listing-item");

filters.forEach((filter) => {
  filter.addEventListener("click", () => {

    // 1. Remove active class from all filters
    filters.forEach(f => f.classList.remove("active"));

    // 2. Add active class to clicked filter
    filter.classList.add("active");

    // 3. Get the selected category
    const selected = filter.dataset.category.toLowerCase();

    // 4. Show/hide listings based on category
    listings.forEach((listing) => {
      if (listing.dataset.category === selected) {
        listing.style.display = "block";
      } else {
        listing.style.display = "none";
      }
    });
  });
});

</script>


