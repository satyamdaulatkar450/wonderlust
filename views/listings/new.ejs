<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
    <h3>Create New List</h3>
    <br />
    <form method = "POST" action = "/listing" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
        <lable for="title" class="form-label">Title</lable>
        <input name = "listing[title]" placeholder = "add catchy title" type = "text" class = "form-control" required />
        <div class="valid-feedback"> Title Looks Good!</div>
        </div>
        <div class="mb-3">
          <lable for="description" class="form-label">Description</lable>
          <textarea name = "listing[description]" placeholder = "enter description" class="form-control" required></textarea>
        </div>
        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" class="form-select" required>
            <option value="" disabled selected>Select a Category</option>
            <option value="trending">🔥 Trending</option>
            <option value="rooms">🛏️ Rooms</option>
            <option value="iconic cities">🏙️ Iconic Cities</option>
            <option value="castles">🏰 Castles</option>
            <option value="amazing pools">🏊 Amazing Pools</option>
            <option value="camping">⛺ Camping</option>
            <option value="farms">🚜 Farms</option>
            <option value="arctic">❄️ Arctic</option>
            <option value="domes">🏔️ Domes</option>
            <option value="boat">⛵ Boat</option>
            <option value="other">🏷️ Other</option>
          </select>
          <div class="invalid-feedback">Please select a category</div>  
       <div class="mb-3 mt-2" id="otherCategoryBox" style="display:none;">
           <input type="text" name="listing[customCategory]" 
               class="form-control" 
               placeholder="Describe your category..." />
      </div>
          <div class="invalid-feedback">Please select a category</div>
        </div>
        <div class="mb-3">
          <lable for="image" class="form-label">Upload Listing Image</lable>  
          <input name = "listing[image]" type = "file" class="form-control" />
        </div>
        <div class ="row">
          <div class="mb-3 col-md-4">
           <lable for="Price" class="form-label">Price</lable> 
           <input name = "listing[price]" placeholder = "1200"class = "form-control" required>
           <div class="invalid-feedback">price should be valid</div>
        </div>
        <div class="mb-3 col-md-8">
           <lable for="country" class="form-label">Country</lable> 
           <input name = "listing[country]" placeholder = "India" type = "text"class = "form-control" required>
           <div class="invalid-feedback">Country should be valid</div>
        </div>
        </div>
        <div class="mb-3">
          <lable for="location" class="form-label">Location</lable> 
           <input name = "listing[location]" placeholder = "Jaipur,Rajasthan" type = "text"class = "form-control" required /> 
           <div class="invalid-feedback">location should be valid</div>
        </div>
          <br />
        <button class="btn btn-dark  add-btn">Add</button>
    </form>
    <br />
        <br />
        </div>
    </div>
    <script>
  const categorySelect = document.querySelector("select[name='listing[category]']");
  const otherBox = document.getElementById("otherCategoryBox");

  if(categorySelect){
    categorySelect.addEventListener("change", () => {
      if(categorySelect.value === "other"){
        otherBox.style.display = "block";
      } else {
        otherBox.style.display = "none";
      }
    });
  }
</script>
</body>
